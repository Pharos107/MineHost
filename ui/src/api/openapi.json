{
  "openapi": "3.1.0",
  "info": {
    "title": "MineHost API",
    "description": "API của controller MineHost.",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.2.0"
  },
  "paths": {
    "/api/v1/app/shutdown": {
      "post": {
        "tags": [
          "system"
        ],
        "operationId": "shutdown",
        "responses": {
          "202": {
            "description": "MineHost đang tắt an toàn mọi server rồi thoát"
          }
        }
      }
    },
    "/api/v1/catalog/paper/versions": {
      "get": {
        "tags": [
          "catalog"
        ],
        "operationId": "paper_versions",
        "responses": {
          "200": {
            "description": "Bản release Paper có build STABLE, mới nhất trước",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogVersionDto"
                  }
                }
              }
            }
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Controller đang chạy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "operationId": "list",
        "parameters": [
          {
            "name": "server_id",
            "in": "path",
            "description": "ULID của server. Bỏ qua thì lấy mọi Job đang giữ.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobDto"
                  }
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDto"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}/cancel": {
      "post": {
        "tags": [
          "jobs"
        ],
        "operationId": "cancel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Đã yêu cầu hủy"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servers": {
      "get": {
        "tags": [
          "servers"
        ],
        "operationId": "list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ServerDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "servers"
        ],
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateServerBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Job cài server đã chạy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedDto"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servers/{id}": {
      "get": {
        "tags": [
          "servers"
        ],
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerDto"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "servers"
        ],
        "operationId": "trash",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "confirm_name",
            "in": "path",
            "description": "Tên server người dùng gõ lại để xác nhận.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrashedDto"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "servers"
        ],
        "operationId": "patch",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchServerBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerDto"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servers/{id}/actions/{action}": {
      "post": {
        "tags": [
          "servers"
        ],
        "operationId": "action",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "path",
            "description": "start, stop, restart, kill",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Đã nhận lệnh"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servers/{id}/console": {
      "get": {
        "tags": [
          "console"
        ],
        "operationId": "console",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after_seq",
            "in": "path",
            "description": "Chỉ lấy các dòng có `seq` lớn hơn giá trị này.",
            "required": true,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsoleDto"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "console"
        ],
        "operationId": "send_command",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Đã gửi lệnh"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servers/{id}/eula": {
      "post": {
        "tags": [
          "servers"
        ],
        "operationId": "eula",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EulaBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerDto"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servers/{id}/metrics": {
      "get": {
        "tags": [
          "servers"
        ],
        "operationId": "metrics",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "path",
            "description": "RFC 3339. Chỉ lấy mẫu sau thời điểm này. Dấu `+` trong offset phải viết `%2B`.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerMetricsDto"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servers/{id}/properties": {
      "get": {
        "tags": [
          "servers"
        ],
        "operationId": "get_properties",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertiesDto"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "servers"
        ],
        "operationId": "put_properties",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PropertiesDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Đã lưu"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "system_info",
        "responses": {
          "200": {
            "description": "RAM, CPU và ổ đĩa của máy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemDto"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi nội bộ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogVersionDto": {
        "type": "object",
        "required": [
          "id",
          "release_time"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "java_major": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Chưa có ở P1: biết được bản Java phải tải JSON của từng phiên bản.",
            "minimum": 0
          },
          "release_time": {
            "type": "string",
            "description": "RFC 3339."
          }
        }
      },
      "CommandBody": {
        "type": "object",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string"
          }
        }
      },
      "ConsoleDto": {
        "type": "object",
        "required": [
          "lines"
        ],
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsoleLineDto"
            }
          }
        }
      },
      "ConsoleLineDto": {
        "type": "object",
        "required": [
          "seq",
          "stream",
          "text"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "stream": {
            "$ref": "#/components/schemas/StreamDto"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "CrashDto": {
        "type": "object",
        "required": [
          "last_lines"
        ],
        "properties": {
          "exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "hint": {
            "type": [
              "string",
              "null"
            ],
            "description": "Ví dụ `NOT_ENOUGH_MEMORY`; không có nếu không đoán được nguyên nhân."
          },
          "last_lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateServerBody": {
        "type": "object",
        "required": [
          "name",
          "loader",
          "minecraft"
        ],
        "properties": {
          "loader": {
            "type": "string",
            "description": "P1 chỉ có `paper`."
          },
          "memory_mb": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/MemoryDto"
              },
              {
                "type": "null"
              }
            ]
          },
          "minecraft": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "port": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "CreatedDto": {
        "type": "object",
        "required": [
          "server_id",
          "job_id"
        ],
        "properties": {
          "job_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "server_id": {
            "type": "string"
          }
        }
      },
      "DiskDto": {
        "type": "object",
        "required": [
          "mount_point",
          "total_bytes",
          "available_bytes"
        ],
        "properties": {
          "available_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "mount_point": {
            "type": "string"
          },
          "total_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Thân response khi có lỗi. Frontend dịch theo `code`; backend không gửi câu chữ đã dịch.",
        "required": [
          "code",
          "params"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Một giá trị của `ErrorCode`, ví dụ `NOT_FOUND`."
          },
          "params": {
            "type": "object",
            "description": "Tham số để ghép vào bản dịch, ví dụ `{ \"port\": 25565 }`."
          }
        }
      },
      "EulaBody": {
        "type": "object",
        "required": [
          "accept"
        ],
        "properties": {
          "accept": {
            "type": "boolean",
            "description": "Phải là `true`: người dùng bấm \"Tôi đồng ý\"."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "JobDto": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "state",
          "started_at"
        ],
        "properties": {
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ErrorBody",
                "description": "Có khi `state` là `failed`."
              },
              {
                "type": "null"
              }
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "RFC 3339, lúc Job sang trạng thái kết thúc. Không có khi còn chạy."
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "description": "Ví dụ `create_server`."
          },
          "progress": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProgressDto"
              },
              {
                "type": "null"
              }
            ]
          },
          "server_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "started_at": {
            "type": "string",
            "description": "RFC 3339, lúc Job được tạo."
          },
          "state": {
            "$ref": "#/components/schemas/JobStateDto"
          }
        }
      },
      "JobStateDto": {
        "type": "string",
        "enum": [
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "MemoryDto": {
        "type": "object",
        "required": [
          "min",
          "max"
        ],
        "properties": {
          "max": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "min": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "MetricSampleDto": {
        "type": "object",
        "required": [
          "at",
          "cpu_percent",
          "memory_bytes"
        ],
        "properties": {
          "at": {
            "type": "string",
            "description": "RFC 3339."
          },
          "cpu_percent": {
            "type": "number",
            "format": "float"
          },
          "memory_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "players": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "`null` cho tới khi có theo dõi người chơi.",
            "minimum": 0
          }
        }
      },
      "PatchServerBody": {
        "type": "object",
        "properties": {
          "autostart": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "memory_mb": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/MemoryDto"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
